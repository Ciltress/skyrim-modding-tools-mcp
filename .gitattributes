# Auto detect text files and perform LF normalization
* text=auto

# Anything that runs inside the Linux image keeps LF whatever the host does.
# A CRLF checkout of a shell script turns its shebang into `/bin/sh\r`, and the
# container then fails with "no such file or directory" naming a file that is
# plainly there.
*.sh text eol=lf

# The guides are served whole, as they are on disk: checked out with CRLF on Windows, every one reaches a
# model with `\r\n` in it. LF everywhere, as the core's are, so what is served does not depend on the system.
*.md text eol=lf
