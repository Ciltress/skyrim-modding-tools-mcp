<Project Sdk="Microsoft.NET.Sdk">

  <!--
    The plugin engine behind the MCP server (docs/adr/0003). Speaks JSON lines on stdio; see Program.cs.

    Mutagen and its serialization generator are pinned together, to the versions a Spriggit release
    builds against, so the project text this writes is Spriggit's own format
    (docs/research/2026-10-15-spriggit-embedding-spike.md). Bump them together, never one alone.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>0.1.0</Version>
    <!-- .NET 9+ shadow-stack enforcement crashes under Mod Organizer's virtual file system. -->
    <CETCompat>false</CETCompat>
    <!-- Not InvariantGlobalization: Mutagen's YAML writer formats numbers with the 'en' culture. -->
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Mutagen.Bethesda.Skyrim" Version="[0.54.0]" />
    <PackageReference Include="Mutagen.Bethesda.Core" Version="[0.54.0]" />
    <PackageReference Include="Mutagen.Bethesda.Serialization" Version="[1.38.6]" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.Yaml" Version="[1.38.6]" />
    <PackageReference Include="Mutagen.Bethesda.Serialization.SourceGenerator" Version="[1.38.6]" />
    <PackageReference Include="Noggog.CSharpExt" Version="[4.3.0]" />
    <!-- Downloaded files: .7z, .zip, .rar (MIT). -->
    <PackageReference Include="SharpCompress" Version="[0.50.4]" />
  </ItemGroup>

</Project>
