# Keep the build context small, and keep secrets out of the image.
#
# `docs/`, `skills/` and `AGENTS.md` are deliberately absent from this file:
# they are read at runtime (as guides, skills and resources), and the Dockerfile
# copies them in.

.git
.gitattributes
.gitmodules
.github

node_modules
dist
coverage

# Credentials. `.env` above all: config belongs in `docker run --env-file` or
# the MCP client's `env` block, never baked into a layer.
.env
.env.*
!.env.example
*.p12
*.pfx
*.pem
*.key

# Agent and editor state, not part of a build.
.claude
.vscode
.idea
*.code-workspace

Dockerfile
.dockerignore
