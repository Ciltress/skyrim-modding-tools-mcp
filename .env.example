# Copy to .env and adjust. With Mod Organizer (the default) only SKYRIM_MO2_INSTANCE is
# required; with Amethyst, SKYRIM_MOD_MANAGER=amethyst is enough. An MCP client's `env`
# block wins over this file.
#
# Every variable is declared in server.json too, and serverManifest.test.ts holds
# the two together with the code that reads them.

# ---------------------------------------------------------------------------
# The mod manager, its instance, and the tools around it
# ---------------------------------------------------------------------------

# The mod manager: mo2 (Mod Organizer 2, the default) or amethyst (Amethyst, Linux).
#SKYRIM_MOD_MANAGER=amethyst

# With mo2, required: the instance folder (where ModOrganizer.exe and ModOrganizer.ini are).
# The server follows whichever profile Mod Organizer has selected.
SKYRIM_MO2_INSTANCE=G:\Modding\SkyrimSE-Test

# With mo2 under Proton (Linux): the Wine prefix Mod Organizer runs in, the folder with dosdevices in it.
# Found by itself for an MO2-LINT install; without one, only paths on Z: are read.
#SKYRIM_WINE_PREFIX=~/.local/share/Steam/steamapps/compatdata/489830/pfx

# With amethyst: its config folder. Found by itself — the Flatpak's
# ~/.var/app/io.github.Amethyst.ModManager/config/AmethystModManager, else ~/.config/AmethystModManager.
#SKYRIM_AMETHYST_DIR=

# Your personal Nexus Mods API key, from https://www.nexusmods.com/settings/api-keys. Searching and
# reading Nexus need none; downloading needs a premium account's. healthcheck shows its account.
# Personal use only — never share it.
#NEXUS_API_KEY=

# Where projects live. Defaults to ./projects beside the server.
#SKYRIM_PROJECTS_DIR=projects

# The Creation Kit folder, for the Papyrus compiler and vanilla script sources.
# Defaults to the instance's game folder.
#SKYRIM_CK_DIR=G:\Steam\steamapps\common\Skyrim Special Edition

# The Papyrus compiler: the Creation Kit's PapyrusCompiler.exe (the default on Windows),
# or russo-2025's papyrus-compiler — required on Linux to compile scripts.
#SKYRIM_PAPYRUS_COMPILER=/home/me/tools/papyrus-compiler/papyrus-compiler

# The built plugin helper. Defaults to helper/bin/SkyrimHelper(.exe) (npm run build:helper).
#SKYRIM_HELPER_PATH=

# ---------------------------------------------------------------------------
# Tools
# ---------------------------------------------------------------------------

# Which tools are listed AND callable: core | readonly | all (default).
# A tool outside the profile cannot be called, so `readonly` really cannot write.
#MCP_PROFILE=core

# Ceiling on one answer in bytes; 0 removes it. Defaults to the profile's.
#MCP_MAX_RESPONSE_BYTES=24000

# off skips asking the backend which optional features it supports.
#MCP_GATE=off

# ---------------------------------------------------------------------------
# Transport — see docs/Hosting.md
# ---------------------------------------------------------------------------

# stdio (default) or http (Streamable HTTP at /mcp, one session per bearer token).
#MCP_TRANSPORT=http
#MCP_HTTP_PORT=3000
#MCP_HTTP_HOST=127.0.0.1

# Bearer tokens HTTP callers may present. Unset, HTTP mode accepts nobody.
#SKYRIM_ACCEPTED_TOKENS=change-me

# Browser origins allowed to call /mcp; * allows any. Empty (default) serves none.
#MCP_HTTP_ALLOWED_ORIGINS=https://ide.example.com
# Host values answered to. Empty (default) accepts any.
#MCP_HTTP_ALLOWED_HOSTS=mcp.example.com
# Requests per minute per session. 0 (default) is off.
#MCP_HTTP_RATE_LIMIT=120
