{
  "name": "skyrim-modding-tools-mcp",
  "version": "0.2.15",
  "mcpName": "io.github.ciltress/skyrim-modding-tools-mcp",
  "description": "MCP server for Skyrim SE modding: look up records across a Mod Organizer load order, and author mods and patches as text projects built into plugins",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "skyrim-modding-tools-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "docs",
    "AGENTS.md"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:types": "tsc -p tsconfig.json --noEmit",
    "start": "node ./dist/index.js",
    "dev": "npx @modelcontextprotocol/inspector ./dist/index.js",
    "setup": "npm ci && npm run build && node dist/setup/main.js",
    "build": "tsc",
    "docs:tools": "node scripts/generate-tool-docs.mjs",
    "smoke": "node scripts/smoke.mjs",
    "build:helper": "npm --prefix node_modules/skyrim-modding-tools-core run build:helper",
    "check:helper": "npm --prefix node_modules/skyrim-modding-tools-core run check:helper"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "skyrim",
    "skyrim-special-edition",
    "modding",
    "mod-organizer",
    "mutagen",
    "spriggit"
  ],
  "author": "Andreas Breit",
  "license": "GPL-3.0-only",
  "engines": {
    "node": ">=24.18.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "dotenv": "^18.0.7",
    "skyrim-modding-tools-core": "github:Ciltress/skyrim-modding-tools-core#v0.2.15"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.0.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "github:Ciltress/skyrim-modding-tools-core#a9ed6e7e4a899f2db8b9e73df73e2ef3f61bc776": true
  }
}
