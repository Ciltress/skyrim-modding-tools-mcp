.env
coverage
dist
node_modules
*.code-workspace

# Credentials and key material — never commit them.
*.p12
*.pfx
*.pem
*.key

# The plugin helper's build output: npm run build:helper rebuilds it.
helper/bin/
helper/*/bin/
helper/*/obj/

# What a project build produces, and what was deployed last.
projects/*/build/
projects/*/.deploy.json

# What npm run setup downloads: the Papyrus compiler on Linux.
tools/

# graphify: only the graph, which `graphify query` reads, and its community names, which took an LLM
# to write. The page, the report, the cache, backups and this machine's state `graphify update .` rebuilds.
graphify-out/*
!graphify-out/graph.json
!graphify-out/.graphify_labels.json
