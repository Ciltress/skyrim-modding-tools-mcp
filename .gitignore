.env
coverage
dist
node_modules
*.code-workspace

# Credentials and key material — never commit them.
*.p12
*.pfx
*.pem
*.key

# The plugin helper's build output: npm run build:helper rebuilds it.
helper/bin/
helper/*/bin/
helper/*/obj/

# What a project build produces, and what was deployed last.
projects/*/build/
projects/*/.deploy.json

# What npm run setup downloads: the Papyrus compiler on Linux.
tools/

# graphify's state on this machine; the graph itself is committed.
graphify-out/cache/
graphify-out/.graphify_python
graphify-out/.graphify_root
graphify-out/cost.json
graphify-out/manifest.json
graphify-out/.graphify_labels.json.sig
graphify-out/.graphify_labels.pending.json
graphify-out/[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]/
